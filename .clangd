CompileFlags:
  Add:
    - -std=c23

    # Подключение правил
    - -Wall
    - -Wextra
    - -Wpedantic # Соответствие стандартам C
    - -Wconversion # Неявное приведение типов
    - -Wstrict-prototypes # Явное наисание void в функция без аргументов
    - -Wvla # Запрет массивов переменной длины в стеке
    - -Wformat=2 # Усиливает проверку форматирования
